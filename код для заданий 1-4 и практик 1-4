class Product:
    # Класс для описания товара
    def __init__(self, name, price, stock, category):
        self.name = name
        self.price = price
        self.stock = stock
        self.category = category

    def __str__(self):
        return f"{self.name} ({self.category}) - {self.price} руб. (В наличии: {self.stock})"

    def reduce_stock(self, quantity):
        # Уменьшает количество товара на складе
        if self.stock >= quantity:
            self.stock -= quantity
            return True
        return False


class ShoppingCart:
    # Класс корзины покупателя
    def __init__(self):
        self.items = {} 

    def add_item(self, product, quantity=1):
        # Добавляет товар в корзину
        if product.stock >= quantity:
            self.items[product] = self.items.get(product, 0) + quantity
            print(f"Товар '{product.name}' добавлен в корзину (x{quantity}).")
        else:
            print(f"Недостаточно товара '{product.name}' на складе.")

    def remove_item(self, product):
        # Удаляет товар из корзины
        if product in self.items:
            del self.items[product]
            print(f"Товар '{product.name}' удален из корзины.")
        else:
            print(f"Товара '{product.name}' нет в корзине.")

    def update_quantity(self, product, quantity):
        # Обновляет количество товара в корзине
        if product in self.items:
            if product.stock >= quantity:
                self.items[product] = quantity
                print(f"Количество товара '{product.name}' обновлено до {quantity}.")
            else:
                print(f"Недостаточно товара '{product.name}' на складе для обновления.")
        else:
            print(f"Товара '{product.name}' нет в корзине. Сначала добавьте его.")

    def get_subtotal(self):
        # Считает общую стоимость товаров в корзине без скидок и налогов
        return sum(product.price * qty for product, qty in self.items.items())

    def clear(self):
        # Очищает корзину после оформления заказа
        self.items = {}


class Order:
    # Класс заказа, обрабатывающий покупку
    def __init__(self, customer, cart, discount_rate=0.0, tax_rate=0.0):
        self.customer = customer
        self.items = cart.items.copy()
        self.discount_rate = discount_rate
        self.tax_rate = tax_rate
        self.total_price = self.calculate_total()

    def calculate_total(self):
        # Рассчитывает итоговую цену с учетом скидок и налогов
        subtotal = sum(product.price * qty for product, qty in self.items.items())
        discount_amount = subtotal * self.discount_rate
        price_after_discount = subtotal - discount_amount
        tax_amount = price_after_discount * self.tax_rate
        return price_after_discount + tax_amount

    def process_purchase(self):
        # Проводит оплату и списывает товары со склада
        for product, qty in self.items.items():
            if product.stock < qty:
                print(f"Ошибка оформления: товара '{product.name}' не хватает на складе.")
                return False
        
        for product, qty in self.items.items():
            product.reduce_stock(qty)
            
        self.customer.add_order(self)
        print(f"Заказ успешно оформлен! Итоговая сумма: {self.total_price:.2f} руб.")
        return True


class Customer:
    # Класс пользователя (покупателя)
    def __init__(self, name, email):
        self.name = name
