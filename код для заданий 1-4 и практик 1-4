import datetime

class Book:
    def __init__(self, title, author, year):
        self.title = title
        self.author = author
        self.year = int(year)

    def info(self):
        return f"книга - {self.title}, автор - {self.author}, год - {self.year}"

    def __str__(self):
        return f"книга - {self.title}, автор - {self.author}, год - {self.year}"

    def __eq__(self, other):
        if not isinstance(other, Book):
            return False
        return self.title == other.title and self.author == other.author and self.year == other.year

    @property
    def age(self):
        return datetime.date.today().year - self.year

    @classmethod
    def from_string(cls, book_str):
        title, author, year = map(str.strip, book_str.split(","))
        return cls(title, author, year)

class EBook(Book):
    def __init__(self, title, author, year, tipe):
        super().__init__(title, author, year)
        self.tipe = tipe

    def info(self):
        return f"{super().info()}, тип - {self.tipe}"


book_1 = EBook(title="негритания", author="кто то там", year="12789", tipe="электронная")
book_2 = Book(title="негритания", author="кто то там", year="12789")

print(book_1.info())
print(book_2.info())

print(book_2)
print(book_2.age)

book_from_str = Book.from_string("негритания, кто то там, 12789")
print(book_2 == book_from_str)



