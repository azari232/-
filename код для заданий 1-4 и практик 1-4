class CrewMember:
    # Класс, представляющий члена экипажа
    def __init__(self, name, role, health=100):
        self.name = name
        self.role = role
        self.health = health
        self.skills = []

    def add_skill(self, skill):
        # Добавляет навык члену экипажа
        if skill not in self.skills:
            self.skills.append(skill)

    def take_damage(self, damage):
        # Получение урона
        self.health = max(0, self.health - damage)
        print(f"{self.name} получил {damage} урона. Здоровье: {self.health}")

    def heal(self, amount):
        # Восстановление здоровья
        self.health = min(100, self.health + amount)
        print(f"{self.name} восстановил здоровье. Текущее здоровье: {self.health}")


class SpaceShip:
    # Класс для управления космическим кораблем
    def __init__(self, name, max_fuel=100):
        self.name = name
        self.fuel = max_fuel
        self.max_fuel = max_fuel
        self.hull_integrity = 100
        self.current_speed = 0
        self.crew = []

    def add_crew_member(self, crew_member):
        # Добавляет члена экипажа на корабль
        self.crew.append(crew_member)

    def accelerate(self, amount):
        # Ускорение корабля с расходом топлива
        fuel_needed = amount * 0.5
        if self.fuel >= fuel_needed:
            self.fuel -= fuel_needed
            self.current_speed += amount
            print(f"Корабль ускорился до {self.current_speed} км/с. Остаток топлива: {self.fuel:.1f}")
        else:
            print("Недостаточно топлива для ускорения!")

    def decelerate(self, amount):
        # Торможение корабля
        self.current_speed = max(0, self.current_speed - amount)
        print(f"Корабль замедлился до {self.current_speed} км/с.")

    def take_damage(self, damage):
        # Получение урона корпусом
        self.hull_integrity = max(0, self.hull_integrity - damage)
        print(f"Корпус корабля получил повреждения! Целостность: {self.hull_integrity}%")
        if self.hull_integrity == 0:
            print("КРИТИЧЕСКОЕ ПОВРЕЖДЕНИЕ! Корабль уничтожен.")

    def refuel(self, amount):
        # Заправка корабля
        self.fuel = min(self.max_fuel, self.fuel + amount)
        print(f"Корабль заправлен. Текущий уровень топлива: {self.fuel}")


class Mission:
    # Класс, определяющий миссию, цели, ресурсы и события
    def __init__(self, name, ship, goals, resources):
        self.name = name
        self.ship = ship
        self.goals = goals
        self.resources = resources
        self.events = [
            "Встреча с астероидами",
            "Отказ системы жизнеобеспечения",
            "Обнаружение неизвестного сигнала",
            "Утечка топлива"
        ]
        self.is_completed = False

    def check_goals(self):
        # Проверка выполнения целей миссии
        print(f"Проверка целей миссии '{self.name}'...")
        for goal in self.goals:
            print(f" - {goal}: [В процессе/Не выполнено]")

    def trigger_event(self, event_index):
        # Запуск случайного или конкретного события
        if 0 <= event_index < len(self.events):
            event = self.events[event_index]
            print(f"\n[СОБЫТИЕ]: {event}!")
            
            if event == "Встреча с астероидами":
                self.ship.take_damage(20)
            elif event == "Утечка топлива":
                self.ship.fuel = max(0, self.ship.fuel - 30)
                print(f"Потеряно 30 единиц топлива. Остаток: {self.ship.fuel}")
            elif event == "Отказ системы жизнеобеспечения":
                for member in self.ship.crew:
                    member.take_damage(10)
            elif event == "Обнаружение неизвестного сигнала":
                print("Сигнал записан в журнал. Научная ценность миссии повышена.")
        else:
            print("Неверный индекс события.")

    def complete_mission(self):
        # Завершение миссии
        self.is_completed = True
        print(f"Миссия '{self.name}' успешно завершена!")
