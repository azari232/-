add_by_note(goods, 'Морковь 2 2024-03-01')
add_by_note(goods, 'Хлеб 1')              # без даты
add_by_note(goods, 'Куриная грудка 0.8 2024-03-05')

print(goods)
print(find(goods, 'яй'))
