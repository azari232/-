from datetime import datetime
from decimal import Decimal


def add(items, title, amount, expiration_date=None):
    # если такого продукта ещё нет, добавляем пустой список
    if title not in items:
        items[title] = []

    # если дата передана, превращаем строку в дату
    if expiration_date != None:
        date = datetime.strptime(expiration_date, '%Y-%m-%d').date()
    else:
        date = None

    part = {'amount': Decimal(str(amount)), 'expiration_date': date}
    items[title].append(part)


def add_by_note(items, note):
    parts = note.split()

    # проверяем, есть ли в конце дата (два дефиса)
    last = parts[-1]
    if last.count('-') == 2:
        expiration_date = last
        parts = parts[:-1]
    else:
        expiration_date = None

    # последнее оставшееся слово - количество, всё до него - название
    amount = parts[-1]
    title = ' '.join(parts[:-1])

    add(items, title, amount, expiration_date)


def find(items, needle):
    result = []
    needle = needle.lower()
    for title in items:
        if needle in title.lower():
            result.append(title)
    return result


def amount(items, needle):
    total = Decimal('0')
    titles = find(items, needle)
    for title in titles:
        for part in items[title]:
            total = total + part['amount']
    return total


# тестирование
goods = {}

add(goods, 'Яйца', 10, '2024-01-15')
add(goods, 'Яйца', 5, '2024-02-20')       # вторая партия
